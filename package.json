{
  "name": "collection-matcher",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that shows how many copies of each Riftbound card you own, right next to card names on deck sites.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "watch": "node scripts/build.mjs --watch",
    "card-db": "node scripts/build-card-db.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "zip": "node scripts/zip.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "preact": "^10.29.8"
  }
}
